<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body class="page-sectors-index">
  <%- include('partials/header') %>

  <main>
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Full directory</p>
        <h1>All divisions &amp; sectors</h1>
        <p class="hero-lede">Every core competency at 3N Infinity Solutionz, grouped by division. Each sector links through to its own dedicated page &mdash; capabilities, process and a scoped enquiry form.</p>
      </div>
    </section>

    <section class="sectors-section">
      <div class="container">
        <% divisions.forEach(function(div){ %>
          <div class="division-block" id="<%= div.id %>">
            <div class="division-block-header">
              <span class="division-block-code"><%= div.code %></span>
              <div>
                <h3><%= div.name %></h3>
                <p><%= div.description %></p>
              </div>
            </div>
            <div class="sector-grid">
              <% div.sectors.forEach(function(s){ %>
                <a href="/sectors/<%= s.slug %>" class="sector-card">
                  <div class="sector-card-top">
                    <span class="sector-card-code"><%= s.code %></span>
                    <svg class="sector-card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </div>
                  <h4><%= s.name %></h4>
                  <p><%= s.tagline %></p>
                </a>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="cta-band">
      <div class="container cta-band-inner">
        <div>
          <h2>Not sure which division fits your need?</h2>
          <p>Send us a general enquiry and we'll route it internally.</p>
        </div>
        <a href="/contact" class="btn btn-primary btn-lg">Get in touch</a>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
