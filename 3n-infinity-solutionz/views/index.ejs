<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body class="page-home">
  <%- include('partials/header') %>

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="container hero-inner">
        <p class="eyebrow">B2B Service Provider &amp; Product Supplier &mdash; India &amp; UAE</p>
        <h1>
          Nine industrial &amp; corporate<br />
          capabilities. <span class="text-copper">One</span> accountable vendor.
        </h1>
        <p class="hero-lede">
          3N Infinity Solutionz runs robotic solar-panel cleaning contracts, industrial supply,
          hygiene &amp; hospitality products, and corporate procurement lines &mdash; each backed by
          direct manufacturing or verified sourcing, delivered across India and the UAE.
        </p>
        <div class="hero-actions">
          <a href="/sectors" class="btn btn-primary">Explore all sectors</a>
          <a href="/contact" class="btn btn-ghost">Talk to us</a>
        </div>

        <div class="hero-stats">
          <% company.stats.forEach(function(stat){ %>
            <div class="hero-stat">
              <span class="hero-stat-value"><%= stat.value %></span>
              <span class="hero-stat-label"><%= stat.label %></span>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- DIVISION STRIP -->
    <section class="division-strip">
      <div class="container division-strip-inner">
        <% divisions.forEach(function(div){ %>
          <a href="#<%= div.id %>" class="division-chip">
            <span class="division-chip-code"><%= div.code %></span>
            <span class="division-chip-text">
              <strong><%= div.name %></strong>
              <em><%= div.sectors.length %> competencies</em>
            </span>
          </a>
        <% }) %>
      </div>
    </section>

    <!-- SECTOR SELECTOR GRID -->
    <section class="sectors-section" id="sectors">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">What we run</p>
          <h2>Nine competencies, organized into three divisions</h2>
          <p class="section-sub">Every division below operates independently &mdash; pick the one relevant to you and go straight to the detail, quotes and contract model that applies.</p>
        </div>

        <% divisions.forEach(function(div){ %>
          <div class="division-block" id="<%= div.id %>">
            <div class="division-block-header">
              <span class="division-block-code"><%= div.code %></span>
              <div>
                <h3><%= div.name %></h3>
                <p><%= div.description %></p>
              </div>
            </div>
            <div class="sector-grid">
              <% div.sectors.forEach(function(s){ %>
                <a href="/sectors/<%= s.slug %>" class="sector-card">
                  <div class="sector-card-top">
                    <span class="sector-card-code"><%= s.code %></span>
                    <svg class="sector-card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </div>
                  <h4><%= s.name %></h4>
                  <p><%= s.tagline %></p>
                </a>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- WHY 3N -->
    <section class="pillars-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Why 3N Infinity</p>
          <h2>Built for recurring B2B relationships, not one-off orders</h2>
        </div>
        <div class="pillars-grid">
          <% company.pillars.forEach(function(p){ %>
            <div class="pillar-card">
              <h3><%= p.title %></h3>
              <p><%= p.body %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- REGIONS -->
    <section class="regions-section">
      <div class="container regions-inner">
        <div class="section-heading" style="margin-bottom:0;">
          <p class="eyebrow">Where we operate</p>
          <h2>Dual-country delivery across India &amp; UAE</h2>
        </div>
        <div class="regions-grid">
          <% company.regions.forEach(function(r){ %>
            <div class="region-card">
              <h3><%= r.name %></h3>
              <p><%= r.detail %></p>
            </div>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- CTA BAND -->
    <section class="cta-band">
      <div class="container cta-band-inner">
        <div>
          <h2>Consolidate your vendor list to one accountable partner.</h2>
          <p>Tell us which sector you need &mdash; we'll route it straight to the right team.</p>
        </div>
        <a href="/contact" class="btn btn-primary btn-lg">Get in touch</a>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
