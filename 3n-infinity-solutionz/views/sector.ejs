<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body class="page-sector">
  <%- include('partials/header') %>

  <main>
    <section class="sector-hero">
      <div class="container sector-hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> <span>/</span> <a href="/sectors">Sectors</a> <span>/</span> <span><%= sector.name %></span>
        </nav>

        <div class="sector-hero-head">
          <span class="sector-hero-code"><%= sector.code %></span>
          <span class="division-tag"><%= division.name %></span>
        </div>

        <h1><%= sector.name %></h1>
        <p class="sector-tagline"><%= sector.tagline %></p>
        <p class="sector-summary"><%= sector.heroSummary %></p>

        <div class="hero-actions">
          <a href="/contact?sector=<%= sector.slug %>" class="btn btn-primary"><%= sector.ctaLabel %></a>
          <a href="/sectors" class="btn btn-ghost">View other sectors</a>
        </div>
      </div>
    </section>

    <section class="sector-body">
      <div class="container sector-body-grid">
        <div class="sector-main">
          <div class="content-block">
            <h2>Overview</h2>
            <p><%= sector.overview %></p>
          </div>

          <div class="content-block">
            <h2>What's included</h2>
            <ul class="check-list">
              <% sector.capabilities.forEach(function(c){ %>
                <li><%= c %></li>
              <% }) %>
            </ul>
          </div>

          <div class="content-block">
            <h2>How it works</h2>
            <ol class="process-list">
              <% sector.process.forEach(function(step, i){ %>
                <li>
                  <span class="process-num"><%= String(i+1).padStart(2,'0') %></span>
                  <div>
                    <h4><%= step.step %></h4>
                    <p><%= step.detail %></p>
                  </div>
                </li>
              <% }) %>
            </ol>
          </div>
        </div>

        <aside class="sector-sidebar">
          <div class="sidebar-card">
            <h3>Who this is for</h3>
            <ul class="dot-list">
              <% sector.whoFor.forEach(function(w){ %>
                <li><%= w %></li>
              <% }) %>
            </ul>
          </div>

          <div class="sidebar-card sidebar-cta">
            <h3><%= sector.ctaLabel %></h3>
            <p>Get a response from the <%= sector.shortName %> team within one business day.</p>
            <a href="/contact?sector=<%= sector.slug %>" class="btn btn-primary btn-block">Enquire now</a>
            <a href="<%= company.contact.whatsapp %>" class="btn btn-ghost btn-block" target="_blank" rel="noopener">WhatsApp us</a>
          </div>

          <% if (related.length) { %>
          <div class="sidebar-card">
            <h3>More in <%= division.name %></h3>
            <ul class="related-list">
              <% related.forEach(function(r){ %>
                <li><a href="/sectors/<%= r.slug %>"><span class="mega-item-code"><%= r.code %></span><%= r.shortName %></a></li>
              <% }) %>
            </ul>
          </div>
          <% } %>
        </aside>
      </div>
    </section>

    <section class="cta-band">
      <div class="container cta-band-inner">
        <div>
          <h2>Ready to bring <%= sector.shortName.toLowerCase() %> under contract?</h2>
          <p>One form, routed straight to the right division.</p>
        </div>
        <a href="/contact?sector=<%= sector.slug %>" class="btn btn-primary btn-lg">Request a quote</a>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
