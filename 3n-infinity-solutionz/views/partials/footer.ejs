<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <span class="brand-name">3N Infinity</span><span class="brand-sub-inline">Solutionz</span>
      <p class="footer-tagline"><%= company.tagline %></p>
      <div class="footer-regions">
        <% company.regions.forEach(function(r){ %>
          <span class="region-chip"><%= r.name %></span>
        <% }) %>
      </div>
    </div>

    <div class="footer-col">
      <p class="footer-col-title">Divisions</p>
      <ul>
        <% company.divisions.forEach(function(d){ %>
          <li><a href="/sectors#<%= d.id %>"><%= d.name %></a></li>
        <% }) %>
      </ul>
    </div>

    <div class="footer-col">
      <p class="footer-col-title">All Sectors</p>
      <ul class="footer-sector-list">
        <% sectors.forEach(function(s){ %>
          <li><a href="/sectors/<%= s.slug %>"><%= s.shortName %></a></li>
        <% }) %>
      </ul>
    </div>

    <div class="footer-col">
      <p class="footer-col-title">Contact</p>
      <ul>
        <li><a href="mailto:<%= company.contact.email %>"><%= company.contact.email %></a></li>
        <li><a href="tel:<%= company.contact.phoneIndia.replace(/\s/g,'') %>">India: <%= company.contact.phoneIndia %></a></li>
        <li><a href="tel:<%= company.contact.phoneUAE.replace(/\s/g,'') %>">UAE: <%= company.contact.phoneUAE %></a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; <%= new Date().getFullYear() %> 3N Infinity Solutionz. All rights reserved.</p>
    <p class="footer-model"><%= company.model %></p>
  </div>
</footer>
